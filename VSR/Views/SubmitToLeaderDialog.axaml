<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:VSR.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
        x:Class="VSR.Views.SubmitToLeaderDialog"
        Title="Ý kiến trình lãnh đạo"
        Icon="/Assets/app.ico"
        Width="600" Height="420"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F8FAFC">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BoxShadow" Value="0 4 16 0 #0F000000"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#E2E8F0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        
        <!-- Header Bar with Stats Badge -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14 10" Margin="0 0 0 14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="TRÌNH LÃNH ĐẠO BÁO CÁO" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Nhập ý kiến / thuyết minh gửi lãnh đạo phê duyệt" FontSize="11" Foreground="#3B82F6"/>
                </StackPanel>

                <!-- Stats Badge: Số ô đã nhập: Đã nhập / Chưa nhập -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="10 6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtStats" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center">
                            <Run Text="Số ô đã nhập: "/>
                            <Run Name="RunFilled" Text="0" Foreground="#16A34A"/>
                            <Run Text=" / Chưa nhập: "/>
                            <Run Name="RunUnfilled" Text="0" Foreground="#DC2626"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Body Form -->
        <Border Grid.Row="1" Classes="card" Padding="16">
            <StackPanel Spacing="12">
                <!-- Report Name Info -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="Báo cáo:" FontWeight="SemiBold" Foreground="#64748B" FontSize="12" Margin="0 0 8 0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="TxtReportInfo" Text="[Tên báo cáo - Kỳ dữ liệu]" FontWeight="Bold" Foreground="#1E293B" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>

                <Separator Height="1" Background="#E2E8F0"/>

                <!-- Opinion Text Input -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Ý kiến / Ghi chú trình lãnh đạo:" FontWeight="SemiBold" Foreground="#475569" FontSize="12"/>
                    <TextBox Name="TxtOpinion" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             Height="130" 
                             PlaceholderText="Nhập nội dung ý kiến, giải trình hoặc ghi chú gửi kèm cho lãnh đạo..."
                             FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 14 0 0">
            <Button Classes="secondary" Click="OnCancelClick" Width="90" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <TextBlock Text="Hủy" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Classes="primary" Click="OnConfirmClick" MinWidth="150" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Trình Lãnh Đạo" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</Window>
